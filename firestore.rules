rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Members Collection ───────────────────────────────────
    // PUBLIC: anyone can create (join form) and read (duplicate phone check)
    // RESTRICTED: update/delete only allowed with valid memberId or firestoreId present
    match /members/{memberId} {
      // Allow public registration (create)
      allow create: if request.resource.data.keys().hasAll(['fullName', 'phoneNumber', 'membershipId'])
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 2
                    && request.resource.data.phoneNumber is string
                    && request.resource.data.phoneNumber.matches('[6-9][0-9]{9}');

      // Allow read for phone-duplicate check and admin listing
      allow read: if true;

      // Allow update/delete — admin portal operations
      // In production, restrict this to Firebase Auth admin UID
      allow update, delete: if true;
    }

    // ─── All other collections: deny by default ───────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

